%% crossing_tick: how light changes
%% (no arrow applies = light stays the same)
stateDiagram-v2
    GREEN
    YELLOW
    RED
    GREEN --> YELLOW : if timer is at least 30<br/>(GREEN_TIME) or (button_pressed<br/>and timer is at least 10<br/>(MIN_GREEN)): timer becomes 0
    YELLOW --> RED : if timer is at least 5<br/>(YELLOW_TIME): timer becomes 0
    RED --> GREEN : if timer is at least 20<br/>(RED_TIME): timer becomes 0
    note right of GREEN : every time first: timer goes up<br/>by 1
    note right of YELLOW : every time first: timer goes up<br/>by 1
    note right of RED : every time first: timer goes up<br/>by 1

